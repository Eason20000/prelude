<?xml version="1.0" encoding="UTF-8"?>
<!-- Pixiewood manifest of the Android toolchain smoke test.
     SPDX-License-Identifier: GPL-3.0-only
     Build it with pixiewood (sp1ritCS/gtk-android-builder):
       pixiewood prepare pixiewood.xml && pixiewood generate && pixiewood build
     Run prepare inside experiments/android-gtk-smoke: it rewrites
     subprojects/*.wrap there, never at the repo root. -->
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="sem121010">
    <xi:include href="src://data/top.vikasmi.PreludeSmoke.metainfo.xml" parse="xml"/>
  </metainfo>
  <style>
    <theme name="adw"/>
    <icon type="generate">
      <drawable target="foreground" type="avd" path="src://data/ic_launcher_foreground.xml"/>
      <color target="background">#3584e4</color>
    </icon>
  </style>
  <dependencies>
    <glib>
      <patch>hack</patch>
    </glib>
    <fontconfig/>
    <gtk/>
    <libadwaita/>
  </dependencies>
  <build target="prelude-android-smoke">
    <architectures>
      <arch>aarch64</arch>
      <arch>x86_64</arch>
    </architectures>
  </build>
</app>

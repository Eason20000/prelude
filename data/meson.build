# No translations yet, so install the desktop file directly instead of going
# through i18n.merge_file (which requires a po/ directory).
install_data(
    'top.vikasmi.Prelude.desktop',
    install_dir: get_option('datadir') / 'applications',
)
install_data(
    'top.vikasmi.Prelude.metainfo.xml',
    install_dir: get_option('datadir') / 'metainfo',
)
install_data(
    'top.vikasmi.Prelude.gschema.xml',
    install_dir: get_option('datadir') / 'glib-2.0' / 'schemas',
)
install_data(
    'icons/hicolor/scalable/apps/top.vikasmi.Prelude.svg',
    install_dir: get_option('datadir') / 'icons' / 'hicolor' / 'scalable' / 'apps',
)
install_data(
    'icons/hicolor/symbolic/apps/top.vikasmi.Prelude-symbolic.svg',
    install_dir: get_option('datadir') / 'icons' / 'hicolor' / 'symbolic' / 'apps',
)

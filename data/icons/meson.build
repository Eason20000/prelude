# Hicolor icons renamed to the derived APP_ID so development
# (top.vikasmi.Prelude.Devel) and release installs never clash.
install_data(
    'hicolor/scalable/apps/top.vikasmi.Prelude.svg',
    rename: '@0@.svg'.format(application_id),
    install_dir: datadir / 'icons' / 'hicolor' / 'scalable' / 'apps',
)
install_data(
    'hicolor/symbolic/apps/top.vikasmi.Prelude-symbolic.svg',
    rename: '@0@-symbolic.svg'.format(application_id),
    install_dir: datadir / 'icons' / 'hicolor' / 'symbolic' / 'apps',
)

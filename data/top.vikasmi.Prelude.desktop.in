[Desktop Entry]
Name=Prelude
Comment=A MIDI file player built with GTK4 and libadwaita
Exec=prelude
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=AudioVideo;Audio;
Keywords=Audio;MIDI;Player;GTK;
StartupNotify=true
StartupWMClass=@APP_ID@
MimeType=audio/midi;audio/x-midi;
DBusActivatable=true

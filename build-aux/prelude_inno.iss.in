; Inno Setup installer for Prelude (Windows). Generated by
; build-aux/pack_windows.py --installer from this template; @VERSION@,
; @VERSION_SUFFIX@ and @STAGE@ are substituted at pack time. The installer
; file name is finished here (CI only uploads); the portable .zip stays the
; primary artifact, the installer only registers the prefix tree.
#define AppVersion "@VERSION@"
#define StageDir "@STAGE@"

[Setup]
AppId=top.vikasmi.Prelude
AppName=Prelude
AppVersion={#AppVersion}
DefaultDirName={autopf}\Prelude
OutputBaseFilename=prelude-{#AppVersion}@VERSION_SUFFIX@-windows-x64-setup
Compression=lzma2
SolidCompression=yes

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: recursesubdirs

[Icons]
Name: "{autoprograms}\Prelude"; Filename: "{app}\bin\prelude.exe"
